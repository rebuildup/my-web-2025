# Public site config (required)
NEXT_PUBLIC_SITE_URL=https://yusuke-kim.com

# Optional integrations
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=

# Optional CDN
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_IMAGES_CDN=

# Optional CMS API anchoring (defaults to same as NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_CMS_API_BASE_URL=

# Runtime / development toggles
NODE_ENV=production
CMS_USE_RUST_API=1
CMS_API_HOST=127.0.0.1
CMS_API_PORT=3001
CMS_API_BASE_URL=http://127.0.0.1:3001
CMS_API_DATA_DIR=/var/www/yusuke-kim/data/db

# Server-only secrets (GitHub Secrets / .env.production, never commit real values)
RESEND_API_KEY=
RECAPTCHA_SECRET_KEY=
X_BEARER_TOKEN=

# Deploy-only secrets (GitHub Actions deploy.yml)
GCP_SSH_KEY=
GCP_HOST=
GCP_USER=deploy
