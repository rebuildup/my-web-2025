# Minimal env — only what the code reads.
# Real secrets live in: Cloudflare Workers Secrets (`wrangler secret put`),
# GitHub Secrets, or your password manager. See `docs/agent/env-management.md`.

# Public site (required)
NEXT_PUBLIC_SITE_URL=https://yusuke-kim.com

# Runtime mode (required)
NODE_ENV=production

# CMS API (Rust) — required when CMS_USE_RUST_API=1
CMS_USE_RUST_API=1
CMS_API_HOST=127.0.0.1
CMS_API_PORT=3001
CMS_API_BASE_URL=http://127.0.0.1:3001
CMS_API_DATA_DIR=/var/www/yusuke-kim/data/db

# Optional / leave empty unless integrating
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_IMAGES_CDN=
NEXT_PUBLIC_CMS_API_BASE_URL=
X_BEARER_TOKEN=
