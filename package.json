{
	"name": "my-web-2025",
	"version": "2.1.1",
	"private": true,
	"sideEffects": [
		"node_modules/gsap/**",
		"node_modules/@gsap/**"
	],
	"packageManager": "bun@1.3.10",
	"scripts": {
		"dev": "bun --bun next dev -p 3010",
		"dev:cms-api": "bun ./scripts/dev-cms-api.ts",
		"dev:full": "bun ./scripts/dev-with-cms.ts",
		"sync:cms-entries": "bun ./scripts/sync-legacy-contents-to-rust.ts",
		"sync:cms-markdown": "bun ./scripts/sync-legacy-markdown-to-rust.ts",
		"build": "bun scripts/check-env.js && bun --bun next build && bun scripts/copy-content-data.js",
		"start": "bun --bun next start -p 3010",
		"dev:port": "bun x next dev -p $PORT",
		"start:port": "bun --bun next start -p $PORT",
		"type-check": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"migration:add-indexes": "bun src/cms/lib/migrations/add-indexes.ts",
		"wslc:pull": "wslc pull oven/bun:1.3.10-debian",
		"wslc:run": "wslc run -d --name my-web-2025-dev -p 3010:3010 -v .:/workspace -v my-web-2025-node_modules:/workspace/node_modules -w /workspace oven/bun:1.3.10-debian sh -lc \"bun install --frozen-lockfile && bun --bun next dev -p 3010\"",
		"wslc:logs": "wslc logs my-web-2025-dev",
		"wslc:stop": "wslc stop my-web-2025-dev",
		"wslc:remove": "wslc remove my-web-2025-dev",
		"doctor": "bunx react-doctor@latest"
	},
	"trustedDependencies": [
		"msw",
		"unrs-resolver"
	],
	"dependencies": {
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@hello-pangea/dnd": "^18.0.1",
		"@next/bundle-analyzer": "^16.3.0",
		"@radix-ui/react-slot": "^1.3.3",
		"@use-gesture/react": "^10.3.1",
		"animejs": "^4.5.0",
		"autoprefixer": "^10.5.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.13",
		"framer-motion": "^12.43.0",
		"fuse.js": "^7.5.0",
		"gsap": "^3.15.0",
		"isomorphic-dompurify": "^3.21.0",
		"js-tiktoken": "^1.0.21",
		"jszip": "^3.10.1",
		"lucide-react": "^1.28.0",
		"marked": "^18.0.9",
		"motion": "^13.0.0",
		"nanoid": "^6.0.1",
		"next": "^16.3.0",
		"p5": "^2.3.2",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.19.0",
		"prismjs": "^1.30.0",
		"qrcode": "^1.5.4",
		"qrcode.react": "^4.2.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-dropzone": "^19.3.0",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.185.1",
		"typescript": "^7.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.2",
		"@types/p5": "^1.7.7",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/three": "^0.185.4",
		"@types/youtube": "^0.3.0",
		"baseline-browser-mapping": "^2.11.12",
		"chrome-launcher": "^1.2.1",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jsdom": "^29.1.1",
		"knip": "^6.31.0",
		"lighthouse": "^13.4.1",
		"playwright": "^1.62.1",
		"tsx": "^4.23.8"
	},
	"overrides": {
		"three": "^0.185.1"
	}
}
