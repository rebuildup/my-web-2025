# Production overrides — only NEXT_PUBLIC_* and the local-runtime toggles.
# Server-only secrets belong in Cloudflare Workers Secrets
# (`wrangler secret put <NAME>`) or GitHub Secrets for CI.
# See `docs/agent/env-management.md`.

NEXT_PUBLIC_SITE_URL=https://yusuke-kim.com
CMS_USE_RUST_API=1
CMS_API_HOST=127.0.0.1
CMS_API_PORT=3001
CMS_API_BASE_URL=http://127.0.0.1:3001
NODE_ENV=production
