{
  "$schema": "https://knip.dev/schema.json",
  "ignore": ["external/**"],
  "ignoreDependencies": [
    "chrome-launcher",
    "lighthouse",
    "@testing-library/react",
    "@types/youtube",
    "baseline-browser-mapping",
    "jsdom",
    "playwright",
    "tsx"
  ],
  "ignoreBinaries": ["wslc"],
  "treatConfigHintsAsErrors": true,
  "rules": {
    "files": "off",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off"
  }
}
