{
  "$schema": "https://knip.dev/schema.json",
  "ignore": ["external/**"],
  "workspaces": {
    "workers/router": {}
  },
  "ignoreDependencies": [
    "chrome-launcher",
    "lighthouse",
    "baseline-browser-mapping",
    "playwright"
  ],
  "ignoreBinaries": ["wslc", "wrangler"],
  "treatConfigHintsAsErrors": true,
  "rules": {
    "files": "off",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off"
  }
}
